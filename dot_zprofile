# ============================================================
# Homebrew
# ============================================================
eval "$(/opt/homebrew/bin/brew shellenv)"

# PATH 중복 항목 자동 제거 (첫 등장 위치 유지 → 우선순위 보존)
typeset -U path PATH

# ============================================================
# 기본 환경 변수
# ============================================================
export LANG=en_US.UTF-8
export EDITOR=/opt/homebrew/bin/nvim

# ============================================================
# PATH 설정 (로그인 시 1회만 설정)
# ============================================================
export PATH="$HOME/.local/bin:$HOME/bin:$PATH"
export PATH="$HOME/.cargo/bin:$PATH"
export PATH="$HOME/.bun/bin:$PATH"
export PATH="/opt/homebrew/opt/mysql-client/bin:$PATH"
export PATH="/opt/homebrew/opt/coreutils/libexec/gnubin:$PATH"
export PATH="/opt/homebrew/opt/icu4c@77/bin:/opt/homebrew/opt/icu4c@77/sbin:$PATH"
export PATH="$HOME/.opencode/bin:$HOME/.codeium/windsurf/bin:$HOME/.antigravity/antigravity/bin:$PATH"

# Added by Toolbox App
export PATH="$PATH:$HOME/Library/Application Support/JetBrains/Toolbox/scripts"

# Added by Obsidian
export PATH="$PATH:/Applications/Obsidian.app/Contents/MacOS"

# ============================================================
# 언어 런타임 — Python·Ruby·Node 등은 mise가 관리 (.zshrc 의 mise activate)
# pyenv / rbenv / nvm 은 mise 로 통합하여 제거함 (2026-06-17)
# ============================================================

# ============================================================
# 언어 런타임 — Go
# ============================================================
export GOPATH=$HOME/go
export GOROOT="/opt/homebrew/opt/go/libexec"
export PATH="$PATH:${GOPATH}/bin:${GOROOT}/bin"

# ============================================================
# 언어 런타임 — Java
# ============================================================
if /usr/libexec/java_home -v17 >/dev/null 2>&1; then
  export JAVA_HOME=$(/usr/libexec/java_home -v17)
fi

# ============================================================
# 언어 런타임 — Rust
# ============================================================
export CARGO_HOME=$HOME/.cargo

# ============================================================
# Android SDK
# ============================================================
export ANDROID_HOME=$HOME/Library/Android/sdk
export PATH="$PATH:$ANDROID_HOME/emulator:$ANDROID_HOME/platform-tools"
export ANDROID_NDK="$ANDROID_HOME/ndk/28.0.12433566"

# ============================================================
# pnpm
# ============================================================
export PNPM_HOME="$HOME/Library/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME:"*) ;;
  *) export PATH="$PNPM_HOME:$PATH" ;;
esac

# ============================================================
# NVM / SDKMAN 디렉토리
# ============================================================
export NVM_DIR="$HOME/.nvm"
export SDKMAN_DIR="$HOME/.sdkman"

# ============================================================
# Apple 코드서명
# ============================================================
export APPLE_ID=pyunghyuk.yoo@payhere.in
export APPLE_TEAM_ID=2MS57VWFU8
export CSC_LINK=$HOME/developer_id_application_cert.p12

# ============================================================
# 비밀 정보 (토큰, 비밀번호 등)
# ============================================================
[[ -f ~/.secrets ]] && source ~/.secrets

# ============================================================
# 시스템 리소스 제한
# ============================================================
ulimit -n 65536
